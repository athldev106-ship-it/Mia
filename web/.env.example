# ---------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same keys in Vercel.
# Never commit .env.local -- it is gitignored.
#
# The public site renders without any of these: the menu falls back to
# the built-in one and contact details come from src/lib/site.ts. Set
# them to turn on the staff dashboard, the forms, and email alerts.
# ---------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Resend (transactional email)
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
EMAIL_FROM="LeanKafe <hello@example.com>"
# Where reservation and enquiry alerts land.
EMAIL_TO_RESTAURANT=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
