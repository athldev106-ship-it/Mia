# ---------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same keys in Vercel.
# Never commit .env.local -- it is gitignored.
# ---------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Resend (transactional email)
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
EMAIL_FROM="Restaurant <bookings@example.com>"
# Where reservation/enquiry/order alerts land.
EMAIL_TO_RESTAURANT=

# Razorpay (Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
